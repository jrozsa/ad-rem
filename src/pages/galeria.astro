---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import { galleryCategories } from '../data/site';
---

<BaseLayout
	title="Galéria"
	description="Fotografie z farmy v Behynciach, chovu hovädzieho dobytka a realizovaných lesníckych zákaziek."
>
	<section class="page-hero">
		<div class="wrap">
			<p class="eyebrow">Referencie</p>
			<h1>Naša práca v praxi</h1>
			<p>
				Pozrite si fotografie z našej farmy, chovu hovädzieho dobytka a realizovaných lesníckych
				zákaziek.
			</p>
		</div>
	</section>

	<section class="section" style="padding-top: 0;">
		<div class="wrap">
			<div class="gallery-grid" aria-label="Kategórie galérie">
				{galleryCategories.map((category) => <div class="gallery-item">{category}</div>)}
			</div>
			<p class="note" style="margin-top: 1.5rem;">
				Pri lesníckych referenciách uveďte druh práce, všeobecnú lokalitu, približný rozsah, použitú
				techniku a výsledok. Mená klientov ani presné polohy pozemkov nezverejňujte bez ich súhlasu.
			</p>
		</div>
	</section>

	<ContactCta
		title="Chcete podobnú zákazku?"
		text="Napíšte nám základné údaje o lokalite a požadovanom rozsahu. Dohodneme obhliadku a ďalší postup."
		primaryHref="/kontakt/"
		primaryLabel="Poslať dopyt"
	/>
</BaseLayout>
